{
    "name": "alexjarvis/birmingham-recipe-extractor",
    "description": "Extract and display Birmingham Ink recipes",
    "type": "project",
    "license": "ISC",
    "require": {
        "php": ">=8.3 <9.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "files": [
            "utility/functions.php",
            "utility/recipe_repository.php",
            "utility/archive_parser.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpstan analyse --memory-limit=512M"
    }
}
